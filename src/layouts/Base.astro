---
/*
 * 全ページ共通の枠組み（<head>の中身・ヘッダー・フッター）。
 * 検索エンジン向けの設定（title / description / OGP / 構造化データ）もここです。
 * 通常、この中身を編集する必要はありません。文章は src/data/site.mjs で変えられます。
 */
import { site } from '../data/site.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, description, path = Astro.url.pathname } = Astro.props;

// ページのタイトル。トップページだけは「会社名｜説明」の形にする。
const pageTitle = title ? `${title}｜${site.name}` : `${site.name}｜${site.tagline}`;
const pageDescription = description ?? site.description;
const canonical = new URL(path, site.url).href;

// Google などに会社情報を正しく伝えるための構造化データ。
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.name,
  alternateName: site.nameVariants,
  // 法人番号（同名の会社との取り違えを防ぐ）
  identifier: {
    '@type': 'PropertyValue',
    name: '法人番号',
    value: site.corporateNumber,
  },
  url: site.url,
  description: site.description,
  telephone: site.contact.tel,
  email: site.contact.email,
  // 所在地は公開しない方針。対応範囲だけを日本全国として伝える。
  areaServed: { '@type': 'Country', name: '日本' },
  // SNSのプロフィールを「同じ会社のもの」としてGoogleに伝える。
  sameAs: Object.values(site.social).filter(Boolean),
};

// サイトそのものの情報。社名での検索時に正式名称を結び付けやすくする。
const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: site.nameVariants,
  url: site.url,
  inLanguage: 'ja',
  publisher: { '@type': 'Organization', name: site.name },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={new URL('/ogp.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}｜${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/ogp.png', site.url).href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteLd)} is:inline />

    {/* 管理画面のログイン用。招待メールのリンクを踏むと /admin/ に飛ばします。 */}
    {site.cms && (
      <>
        <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline />
        <script is:inline>
          window.netlifyIdentity &&
            window.netlifyIdentity.on('init', (user) => {
              if (!user) {
                window.netlifyIdentity.on('login', () => {
                  document.location.href = '/admin/';
                });
              }
            });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
