---
import { site } from '../data/site.mjs';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__cols">
    <div>
      <h2>{site.name}</h2>
      <p>北海道札幌市</p>
      <p>
        TEL:&nbsp;<a href={`tel:${site.contact.tel.replace(/-/g, '')}`}>{site.contact.tel}</a>
        <br />
        Email:&nbsp;<a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <br />
        定休日:&nbsp;{site.contact.holidays}
      </p>
      <SocialLinks />
    </div>
    <div>
      <h2>メニュー</h2>
      <ul>
        <li><a href="/">ホーム</a></li>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap site-footer__legal">
    <p>© {year} {site.name}</p>
  </div>
</footer>
