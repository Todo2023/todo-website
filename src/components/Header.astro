---
import { site } from '../data/site.mjs';
import Logo from './Logo.astro';

// 現在開いているページのメニュー項目に印をつけるための判定。
const here = Astro.url.pathname;

// お問い合わせは、リンクではなくボタンとして右端に出すため、一覧からは外す。
const navItems = site.nav.filter((item) => item.href !== '/contact/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-logo" href="/">
      <Logo size={36} />
      <span class="site-logo__text">
        <span class="site-logo__mark">To do</span>
        <span class="site-logo__sub">合同会社To do</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="メインメニュー">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      class="site-header__cta"
      href="/contact/"
      aria-current={here === '/contact/' ? 'page' : undefined}
    >
      無料相談
    </a>
  </div>
</header>
