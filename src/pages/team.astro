---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.mjs';

const rep = site.representative;
const partners = site.partners;
---

<Base
  title="代表"
  description={`合同会社To do ${rep.role} ${rep.name}の経歴。キーエンス、パナソニック、工機ホールディングス、カールツァイスで営業・マーケティング・新規事業を担当。案件に応じて専門人材と連携し、関連業務の請負にも対応します。`}
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Representative</span>
      <h1>代表</h1>
      <p>
        キーエンスをはじめとするメーカーの事業側で、営業・マーケティング・新規事業を
        担ってきた代表が、直接お話をうかがいます。
        実務が発生する場合は、案件に応じて専門人材と連携して進めます。
      </p>
    </div>
  </section>

  <!-- 代表 -->
  <section class="section">
    <div class="wrap">
      <div class="profile-name">
        <strong>{rep.name}</strong>
        <span>{rep.role}</span>
      </div>
      <p class="lede">{rep.lead}</p>

      <p class="subhead">経歴</p>
      <ul class="record">
        {rep.career.map((job) => (
          <li>
            <p class="record__org">{job.company}</p>
            {job.roles.length > 0 && (
              <ul class="record__roles">
                {job.roles.map((r) => <li>{r}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <p class="subhead">アドバイザリー実績</p>
      <ul class="record">
        {rep.advisory.map((a) => (
          <li>
            <p class="record__org">{a.theme}</p>
            <ul class="record__roles">
              {a.clients.map((c) => <li>{c}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 協力体制 -->
  <section class="section section--tint">
    <div class="wrap">
      <span class="eyebrow">Partners</span>
      <h2>協力体制</h2>
      <p class="lede">{partners.lead}</p>

      {partners.people.map((m) => (
        <div class="person" style="margin-top:3.5em">
          {m.name && (
            <div class="profile-name">
              <strong>{m.name}</strong>
              <span>{m.role}</span>
            </div>
          )}
          <p class="lede">{m.summary}</p>

          <p class="subhead">これまでお引き受けしてきた業務</p>
          <ul class="record">
            {m.experience.map((e) => (
              <li>
                <p class="record__org">{e.field}</p>
                <ul class="record__roles">
                  {e.items.map((i) => <li>{i}</li>)}
                </ul>
              </li>
            ))}
          </ul>

          <p class="subhead">保有資格</p>
          <ul class="tags">
            {m.qualifications.map((q) => <li>{q}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Contact</span>
      <h2>関連業務も、まとめてお引き受けします。</h2>
      <p class="lede">
        資料作成、記事執筆、リサーチ、営業支援、経理まわりの事務、AIの活用。
        課題の周辺で発生する実務まで、まとめて対応できます。
        ご相談内容が複数にまたがっていても構いません。
      </p>
      <div class="btn-row">
        <a class="btn btn--on-dark" href="/contact/">お問い合わせ</a>
      </div>
    </div>
  </section>
</Base>
