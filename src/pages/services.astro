---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.mjs';
import Consultation from '../components/Consultation.astro';

const ops = site.operations;
---

<Base
  title="サービス"
  description="合同会社To doのサービス。事業アドバイザリー、COO代行、SEOオウンドメディア運用支援、セミナー講師・社内研修。実務の代行まで引き受けます。30分の無料相談を受け付けています。"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Services</span>
      <h1>サービス</h1>
      <p>{site.servicesIntro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h2>提供しているサービス</h2>
      <div class="grid grid--2" style="margin-top:3em">
        {site.serviceList.map((sv) => (
          <article class="card">
            <h3>{sv.title}</h3>
            <p>{sv.body}</p>
            <p style="margin-top:1.2em"><a href={sv.href}>{sv.linkLabel} →</a></p>
          </article>
        ))}
      </div>

      <p class="consult-note">{site.serviceListNote}</p>
    </div>
  </section>

  <section class="section section--tint" id="advisory">
    <div class="wrap">
      <span class="eyebrow">Advisory</span>
      <h2>アドバイザリー</h2>
      <p class="lede">
        現在地を確かめ、行き先を定め、そこまで一緒に登る。
        この3つを順に進めていきます。
      </p>

      <ol class="steps">
        {site.services.map((s, i) => (
          <li class="step" id={s.id}>
            <div class="step__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Operations</span>
      <h2>{ops.title}</h2>
      <p class="lede">{ops.lead}</p>

      <div class="grid grid--2" style="margin-top:3em">
        {ops.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <span class="eyebrow">COO as a service</span>
      <h2>{site.coo.title}</h2>
      <p class="lede">{site.coo.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/services/coo/">サービスの詳細を見る</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">SEO / Owned media</span>
      <h2>{site.seo.title}</h2>
      <p class="lede">{site.seo.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/services/seo/">サービスの詳細を見る</a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <span class="eyebrow">Seminar / Training</span>
      <h2>{site.seminar.title}</h2>
      <p class="lede">{site.seminar.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/services/seminar/">サービスの詳細を見る</a>
      </div>
    </div>
  </section>

  <section class="section" id="expertise">
    <div class="wrap">
      <span class="eyebrow">Expertise</span>
      <h2>{site.expertise.title}</h2>
      <p class="lede">{site.expertise.lead}</p>

      <ul class="areas">
        {site.expertise.areas.map((a) => (
          <li>
            <div>
              <h3>{a.title}</h3>
              <p class="areas__from">{a.from}</p>
            </div>
            <p class="areas__body">{a.body}</p>
          </li>
        ))}
      </ul>

      <div class="prose" style="margin-top:4em">
        <h3>{site.expertise.advisoryTitle}</h3>
        <p>{site.expertise.advisoryBody}</p>
        <p>{site.expertise.advisoryNote}</p>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Process</span>
      <h2>ご依頼の流れ</h2>

      <ol class="steps">
        <li class="step">
          <div class="step__num">01</div>
          <h3 class="step__title">ご相談</h3>
          <p class="step__body">
            メールまたはお申し込みフォームからご連絡ください。今おかれている状況と、
            どこまで決まっているのかをうかがいます。
          </p>
        </li>
        <li class="step">
          <div class="step__num">02</div>
          <h3 class="step__title">ご提案・お見積り</h3>
          <p class="step__body">
            お手伝いできる範囲、進め方、費用と期間をお出しします。
            ここまでは費用をいただきません。
          </p>
        </li>
        <li class="step">
          <div class="step__num">03</div>
          <h3 class="step__title">着手・伴走</h3>
          <p class="step__body">
            継続的にご一緒する場合は、期間ごとに論点と進み方を見直しながら進めます。
          </p>
        </li>
      </ol>

    </div>
  </section>

  <Consultation />
</Base>
