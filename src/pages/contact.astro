---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.mjs';
import Consultation from '../components/Consultation.astro';

const { email, holidays, replyWithin, mailChecklist, formUrl } = site.contact;

// Googleフォームは ?embedded=true を付けるとページ内に馴染む見た目になる。
// 短縮URL（forms.gle/...）は転送先が実際に開くまで分からず埋め込めないので、
// その場合はボタンで別タブに開く形にする。
const canEmbed = Boolean(formUrl?.includes('docs.google.com/forms'));
const embedUrl = canEmbed
  ? `${formUrl.split('?')[0].replace(/\/(edit|viewform)?$/, '/viewform')}?embedded=true`
  : null;
---

<Base
  title="無料相談・お問い合わせ"
  description="合同会社To doは30分の無料相談を受け付けています。オンライン（Google Meet）で実施し、費用はかかりません。業務提携・協業のご相談も承っています。2営業日以内にご返信します。"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Contact</span>
      <h1>無料相談・お問い合わせ</h1>
      <p>
        30分の無料相談を受け付けています。「これは頼めるだろうか」という段階でも構いません。
        業務提携・協業のご相談も、同じ窓口で承ります。2営業日以内にご返信します。
      </p>
    </div>
  </section>

  <Consultation showCta={false} />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Apply</span>
      <h2>お申し込み・お問い合わせ</h2>
      <p class="lede">
        下記のフォーム、またはメールでご連絡ください。
        無料相談のお申し込み、そのほかのご相談、どちらもこちらで承ります。
      </p>

      <div class="mailbox" style="margin-top:2.6em">
        <p class="mailbox__label">メールでお問い合わせください</p>
        <p class="mailbox__addr">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        <div class="btn-row" style="margin-top:1.8em">
          <a class="btn btn--primary" href={`mailto:${email}?subject=${encodeURIComponent('お問い合わせ（合同会社To do）')}`}>
            メールを作成する
          </a>
        </div>
        <p class="mailbox__note">
          ボタンを押すと、宛先を入れた状態でメールソフトが開きます。
          うまく開かない場合は、上のアドレスをコピーしてお使いください。
        </p>
      </div>

      <div class="prose" style="margin-top:56px">
        <h2>メールに書いていただきたいこと</h2>
        <p>
          次の3点があると、初回の返信でより具体的なご提案ができます。
          分かる範囲で構いません。
        </p>
        <ul class="plainlist">
          {mailChecklist.map((item) => <li>{item}</li>)}
        </ul>
        <p style="margin-top:1.6em">
          {replyWithin}にご返信します。定休日は{holidays}のため、
          お返事が前後する場合があります。
          万一返信がない場合は、迷惑メールフォルダをご確認のうえ、
          お手数ですが再度ご連絡ください。
        </p>
      </div>

      {embedUrl && (
        <div class="form-embed">
          <h2>フォームから申し込む</h2>
          <iframe
            src={embedUrl}
            title="お問い合わせフォーム"
            loading="lazy"
            width="100%"
            height="1100">読み込んでいます…</iframe>
          <p>
            うまく表示されない場合は
            <a href={formUrl} target="_blank" rel="noopener">こちらから別ページで開けます</a>。
          </p>
        </div>
      )}

      {formUrl && !embedUrl && (
        <div class="btn-row" style="margin-top:32px">
          <a class="btn btn--primary" href={formUrl} target="_blank" rel="noopener">
            フォームから申し込む
          </a>
        </div>
      )}

      <div class="prose" style="margin-top:48px">
        <h2>お打ち合わせについて</h2>
        <p>
          お打ち合わせはオンライン（Google Meet 等）で承っています。
          所在地を問わず、全国どこからでもご依頼いただけます。
        </p>
        <p>
          対面でのお打ち合わせをご希望の場合は、日程と場所をご相談ください。
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="partnership">
    <div class="wrap">
      <span class="eyebrow">{site.partnership.label}</span>
      <h2>{site.partnership.title}</h2>
      <p class="lede">{site.partnership.lead}</p>

      <div class="grid grid--3" style="margin-top:3em">
        {site.partnership.seeking.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <p class="consult-note">{site.partnership.note}</p>

      <div class="btn-row">
        <a
          class="btn btn--primary"
          href={`mailto:${email}?subject=${encodeURIComponent('業務提携・協業のご相談（合同会社To do）')}`}
        >
          提携について問い合わせる
        </a>
      </div>
    </div>
  </section>
</Base>
