---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.mjs';

const { tel, email, holidays, formUrl } = site.contact;

// Googleフォームは ?embedded=true を付けるとページ内に馴染む見た目になる。
// 短縮URL（forms.gle/...）は転送先が実際に開くまで分からず埋め込めないので、
// その場合はボタンで別タブに開く形にする。
const canEmbed = Boolean(formUrl?.includes('docs.google.com/forms'));
const embedUrl = canEmbed
  ? `${formUrl.split('?')[0].replace(/\/(edit|viewform)?$/, '/viewform')}?embedded=true`
  : null;
---

<Base
  title="お問い合わせ"
  description="合同会社To doへのお問い合わせ先。お電話またはメールでご連絡ください。ご相談・お見積りは無料です。オンラインでの打ち合わせに対応しています。"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Contact</span>
      <h1>お問い合わせ</h1>
      <p>
        ご相談とお見積りは無料です。「これは頼めるだろうか」という段階でも構いません。
        2営業日以内にご返信します。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2">
        <article class="card">
          <h3>お電話</h3>
          <p style="font-size:1.5rem;font-weight:700">
            <a href={`tel:${tel.replace(/-/g, '')}`}>{tel}</a>
          </p>
          <p>定休日：{holidays}</p>
          <p>つながらない場合はメールをご利用ください。折り返しご連絡します。</p>
        </article>
        <article class="card">
          <h3>メール</h3>
          <p style="font-size:1.15rem;font-weight:700">
            <a href={`mailto:${email}`}>{email}</a>
          </p>
          <p>会社名・お名前・ご相談内容をお書き添えください。</p>
        </article>
      </div>

      {embedUrl && (
        <div class="form-embed">
          <h2>フォームから問い合わせる</h2>
          <iframe
            src={embedUrl}
            title="お問い合わせフォーム"
            loading="lazy"
            width="100%"
            height="1100">読み込んでいます…</iframe>
          <p>
            うまく表示されない場合は
            <a href={formUrl} target="_blank" rel="noopener">こちらから別ページで開けます</a>。
          </p>
        </div>
      )}

      {formUrl && !embedUrl && (
        <div class="btn-row" style="margin-top:32px">
          <a class="btn btn--primary" href={formUrl} target="_blank" rel="noopener">
            フォームから問い合わせる
          </a>
        </div>
      )}

      <div class="prose" style="margin-top:48px">
        <h2>お打ち合わせについて</h2>
        <p>
          北海道札幌市を拠点に活動しています。
          お打ち合わせはオンライン（Google Meet 等）で承っており、全国どこからでもご依頼いただけます。
        </p>
        <p>
          札幌近郊であれば、ご訪問しての打ち合わせも可能です。ご希望の場所をお知らせください。
        </p>
      </div>
    </div>
  </section>
</Base>
