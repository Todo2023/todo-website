---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.mjs';
import { getCollection } from 'astro:content';
import Consultation from '../components/Consultation.astro';

const headlineLines = site.hero.headline.split('｜');

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const rep = site.representative;
---

<Base>
  <section class="hero">
    <div class="wrap">
      <div class="hero__rule"></div>
      <h1>{headlineLines.map((line, i) => (i === 0 ? line : [<br />, line]))}</h1>
      <p class="hero__lead">{site.hero.lead}</p>
      <div class="btn-row">
        <a class="btn btn--on-dark" href={site.hero.primaryCta.href}>{site.hero.primaryCta.label}</a>
        <a class="btn btn--on-dark" href={site.hero.secondaryCta.href}>{site.hero.secondaryCta.label}</a>
      </div>
    </div>
  </section>

  <section class="creds">
    <div class="wrap">
      <p class="creds__label">{site.credentials.label}</p>
      <ul class="creds__list">
        {site.credentials.companies.map((c) => <li>{c}</li>)}
      </ul>
      <p class="creds__note">{site.credentials.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">What we do</span>
      <h2>問題を抽出し、課題を設定する。</h2>
      <p class="lede">
        合同会社To doは、事業会社で意思決定を担ってきた代表が、
        経営の判断に伴走するアドバイザリーです。{site.servicesIntro}
      </p>

      <ol class="steps">
        {site.services.map((s, i) => (
          <li class="step">
            <div class="step__num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))}
      </ol>

      <div class="btn-row">
        <a class="btn btn--ghost" href="/services/">サービスの詳細</a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <span class="eyebrow eyebrow--on-dark">Representative</span>
      <div class="profile-name">
        <strong>{rep.name}</strong>
        <span>{rep.role}</span>
      </div>
      <p class="lede">{rep.lead}</p>
      <p class="lede" style="margin-top:1.4em">{site.partners.lead}</p>
      <div class="btn-row">
        <a class="btn btn--on-dark" href="/team/">代表の経歴を見る</a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <span class="eyebrow">SEO / Owned media</span>
      <h2>{site.seo.title}</h2>
      <p class="lede">{site.seo.lead}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/services/seo/">サービスの詳細を見る</a>
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section">
      <div class="wrap">
        <span class="eyebrow">News</span>
        <h2>お知らせ</h2>
        <ul class="news-list">
          {news.map((post) => (
            <li>
              <a href={`/news/${post.id}/`}>
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{fmt(post.data.date)}</time>
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="btn-row">
          <a class="btn btn--ghost" href="/news/">お知らせ一覧</a>
        </div>
      </div>
    </section>
  )}

  <Consultation />
</Base>
